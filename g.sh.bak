# ================================================================
cat > .dockerignore <<'EOF'
.git
.gitignore
.env
.env.*
!.env.example
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
reports
*.log
.idea
.vscode
.DS_Store
tests
EOF

# ================================================================
# 14. docker-compose.yml (local dev)
# ================================================================
cat > docker-compose.yml <<'EOF'
services:
  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 10

  web:
    build: .
    command: uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload
    ports:
      - "8000:8000"
    environment:
      REDIS_URL: redis://redis:6379/0
    depends_on:
      redis:
        condition: service_healthy
    volumes:
      - ./app:/app/app

  worker:
    build: .
    command: celery -A app.core.celery_app.celery worker --loglevel=info
    environment:
      REDIS_URL: redis://redis:6379/0
    depends_on:
      redis:
        condition: service_healthy
EOF

# ================================================================
# 15. render.yaml (Render Blueprint)
# ================================================================
cat > render.yaml <<'EOF'
services:
  - type: web
    name: anonymity-verifier-web
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    plan: free
    region: oregon
    healthCheckPath: /health
    autoDeploy: true
    envVars:
      - key: ENVIRONMENT
        value: production
      - key: REDIS_URL
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString
      - key: CELERY_BROKER_URL
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString
      - key: CELERY_RESULT_BACKEND
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString

  - type: worker
    name: anonymity-verifier-worker
    runtime: docker
    dockerfilePath: ./Dockerfile
    dockerContext: .
    dockerCommand: celery -A app.core.celery_app.celery worker --loglevel=info --concurrency=2
    plan: starter
    region: oregon
    autoDeploy: true
    envVars:
      - key: ENVIRONMENT
        value: production
      - key: REDIS_URL
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString
      - key: CELERY_BROKER_URL
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString
      - key: CELERY_RESULT_BACKEND
        fromService:
          type: redis
          name: anonymity-verifier-redis
          property: connectionString

  - type: redis
    name: anonymity-verifier-redis
    plan: free
    region: oregon
    ipAllowList: []
    maxmemoryPolicy: noeviction
EOF

# ================================================================
# 16. Makefile
# ================================================================
cat > Makefile <<'EOF'
.PHONY: help install dev worker test up down logs clean

help:
	@echo "Targets: install dev worker test up down logs clean"

install:
	pip install -r requirements.txt

dev:
	uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

worker:
	celery -A app.core.celery_app.celery worker --loglevel=info

test:
	pytest

up:
	docker compose up --build

down:
	docker compose down -v

logs:
	docker compose logs -f web worker

clean:
	find . -type d -name __pycache__ -exec rm -rf {} +
	rm -rf .pytest_cache .mypy_cache .ruff_cache reports
EOF

# ================================================================
# 17. Git init + commit
# ================================================================
if command -v git >/dev/null 2>&1 && [[ ! -d .git ]]; then
    echo "==> Initializing git repository"
    git init -q
    git add -A
    git -c user.name="scaffold" -c user.email="scaffold@local" \
        commit -q -m "feat(part-1): scaffold FastAPI + Celery + Redis + Render Blueprint"
    echo "    Committed."
fi

# ================================================================
# 18. Self-test: verify no smart quotes landed in generated files
# ================================================================
echo "==> Verifying generated files have no smart quotes"
if grep -rlE '[\x{2018}\x{2019}\x{201C}\x{201D}]' app/ tests/ *.toml *.txt *.md 2>/dev/null; then
    echo "ERROR: smart quotes found in generated files (listed above)."
    exit 1
fi
echo "    OK"

# ================================================================
# 19. Final summary
# ================================================================
echo
echo "================================================================"
echo "  Part 1 scaffold complete."
echo "================================================================"
echo
echo "Files generated:"
find . -type f -not -path './.git/*' | sort | sed 's/^/  /'
echo
echo "Next steps:"
echo "  1. cp .env.example .env"
echo "  2. docker compose up --build"
echo "  3. curl http://localhost:8000/health"
echo "  4. pytest -q"
echo "  5. Push to GitHub -> Render Dashboard -> New + -> Blueprint"
echo
