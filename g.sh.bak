#!/usr/bin/env bash
#
# anonym-verifier-part1.sh
# Generates the full Part 1 project (FS + code + deploy config) in the CWD.
# Run: bash anonym-verifier-part1.sh
#
set -euo pipefail

echo "==> Anonymity Verifier — Part 1 generator"
echo "    Working directory: $(pwd)"
echo

# --- Sanity: refuse to run inside an existing app/ dir ---
if [[ -d app ]] || [[ -f Dockerfile ]]; then
    echo "ERROR: app/ or Dockerfile already exists here."
    echo "       Run in an empty directory."
    exit 1
fi

# --- Sanity: detect smart quotes in this script itself ---
if grep -qE '[\x{2018}\x{2019}\x{201C}\x{201D}]' "$0" 2>/dev/null; then
    echo "ERROR: this script contains curly/smart quotes (’, ‘, ”, “)."
    echo "       Re-save with a plain-text editor, or disable autocorrect."
    exit 1
fi

# ================================================================
# 0. Directory tree
# ================================================================
echo "==> Creating directory tree"
mkdir -p app/api app/core app/tasks app/models app/static tests

# ================================================================
# 1. Root config files
# ================================================================
echo "==> Writing root config files"

cat > .gitignore <<'EOF'
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
reports/
*.log
EOF

cat > .env.example <<'EOF'
APP_NAME=Anonymity Verifier
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0
SCAN_RESULT_TTL=3600
EOF

cat > requirements.txt <<'EOF'
fastapi==0.115.0
uvicorn[standard]==0.32.0
celery[redis]==5.4.0
redis==5.1.1
pydantic==2.9.2
pydantic-settings==2.6.0
python-dotenv==1.0.1
httpx==0.27.2
playwright==1.48.0
pytest==8.3.3
pytest-asyncio==0.24.0
EOF

cat > pyproject.toml <<'EOF'
[project]
name = "anonymity-verifier"
version = "0.1.0"
description = "Multi-layer anonymity and leak verification service"
requires-python = ">=3.11"

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]
python_files = ["test_*.py"]
addopts = "-ra -q"
EOF

cat > README.md <<'EOF'
# Anonymity Verifier

Multi-layer service that checks whether your VPN/Tor/proxy setup is actually
hiding what you think it is. Part 1 delivers the deployable skeleton:

- FastAPI web service with /health and /api/v1/scan
- Celery worker consuming scan jobs
- Redis as broker and result backend
- Render Blueprint (render.yaml) provisioning all three
- Docker image based on the official Playwright image

## Local development

    cp .env.example .env
    docker compose up --build

Then:

    curl http://localhost:8000/health
    curl -X POST http://localhost:8000/api/v1/scan -H 'Content-Type: application/json' -d '{}'

## Deploy to Render

1. Push this repo to GitHub.
2. Render Dashboard -> New + -> Blueprint -> select the repo.
3. render.yaml provisions web service, background worker, Redis.
4. /health returns {"celery_workers": true} when ready.

## Roadmap

- Part 1 (this scaffold): stack up, health, placeholder scan.
- Part 2: Layer 1 (IP/DNS/STUN) + Layer 2 (Playwright fingerprint).
- Part 3: Orchestrator, result polling, HTML UI, Layer 3 local agent.
EOF

# ================================================================
# 2. Python — package init files
# ================================================================
echo "==> Writing Python package files"

cat > app/__init__.py <<'EOF'
